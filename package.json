{
  "name": "empery-world-game",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "dev:client": "pnpm --filter @empery/client dev",
    "dev:server": "pnpm --filter @empery/server dev",
    "dev:admin": "pnpm --filter @empery/admin dev",
    "start:infra": "bash scripts/start-infra.sh",
    "stop:infra": "bash scripts/stop-infra.sh",
    "status:infra": "bash scripts/status-infra.sh",
    "start:server": "bash scripts/start-server.sh",
    "start:client": "bash scripts/start-client.sh",
    "start:admin": "bash scripts/start-admin.sh",
    "start:dev": "bash scripts/start-dev.sh",
    "start:all": "bash scripts/start-all.sh",
    "start:server:prod": "bash scripts/start-server-prod.sh",
    "admin:grant": "node --import tsx scripts/admin-grant.ts",
    "generate:media": "tsx scripts/generate-media.ts",
    "generate:media:force": "tsx scripts/generate-media.ts --force",
    "generate:media:skills": "tsx scripts/generate-media.ts --only=skill_",
    "generate:media:items": "tsx scripts/generate-media.ts --only=item_ --force",
    "generate:media:tiles": "tsx scripts/generate-media.ts --only=tileset_",
    "generate:media:terrain": "tsx scripts/bake-terrain-procedural.ts",
    "bake:terrain:haven": "tsx scripts/bake-terrain-procedural.ts",
    "pack:terrain": "tsx scripts/pack-terrain-strip.ts",
    "generate:media:props": "tsx scripts/generate-media.ts --only=prop_",
    "generate:media:dialogue": "tsx scripts/generate-media.ts --only=dialogue_",
    "generate:media:world": "tsx scripts/generate-media.ts --only=tileset_ && tsx scripts/generate-media.ts --only=prop_ && tsx scripts/generate-media.ts --only=sprite_",
    "reprocess:media": "tsx scripts/reprocess-media.ts",
    "convert:media:webp": "tsx scripts/convert-media-webp.ts",
    "pack:atlases": "tsx scripts/pack-media-atlases.ts",
    "generate:maps": "node scripts/generate-maps.mjs",
    "generate:items": "tsx scripts/generate-items.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "oxlint apps packages scripts --deny-warnings",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "ci": "pnpm run check",
    "bake:collision": "node --import tsx scripts/bake-collision-bounds.ts",
    "benchmark:runtime": "node --import tsx apps/server/scripts/benchmark-runtime.ts",
    "persistence:init": "node apps/server/scripts/init-persistence.mjs",
    "soak:network": "node --import tsx apps/server/scripts/soak-network.ts",
    "backup": "node apps/server/scripts/operations.mjs backup",
    "backup:verify": "node apps/server/scripts/operations.mjs verify-restore",
    "monitor": "node apps/server/scripts/operations.mjs monitor",
    "services:install": "node scripts/install-services.mjs",
    "audit:citizen-media": "node scripts/audit-citizen-media.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "oxlint": "^1.83.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@empery/llm": "workspace:*",
    "@empery/media": "workspace:*",
    "@empery/shared": "workspace:*"
  },
  "packageManager": "pnpm@10.6.1",
  "engines": {
    "node": ">=20"
  }
}
